# Server
SERVER_PORT=9090

# DashScope（必填）
# 到阿里云百炼控制台创建 API-KEY：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=sk-your-api-key
LLM_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v3
# Jetty 请求总超时（秒），简历匹配/长提示建议 >= 120
DASHSCOPE_READ_TIMEOUT=300

# Milvus (default off — in-memory question store)
MILVUS_ENABLED=false
MILVUS_HOST=localhost
MILVUS_PORT=19530

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# MySQL（含 & 时请勿用 shell source .env；由应用内 spring-dotenv 读取即可）
MYSQL_URL=jdbc:mysql://localhost:3306/interview_agent?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
MYSQL_USERNAME=root
MYSQL_PASSWORD=interview

# JWT
JWT_SECRET=interview-agent-default-secret

# GitHub (Optional)
GITHUB_TOKEN=

# Interview
INTERVIEW_MAX_QUESTIONS=5
INTERVIEW_ANSWER_TIMEOUT=300

# Auth (local default: off)
AUTH_ENABLED=false
